# Copiez ce fichier en .env.local puis remplacez les valeurs ci-dessous.
# Il est exclusivement destiné aux tests sur votre ordinateur ; n’utilisez aucun secret de production.

# Mot de passe de la base MySQL locale, différent de toute valeur de production.
LOCAL_DB_PASSWORD=remplacez-par-un-mot-de-passe-local-solide

# Chaîne aléatoire d’au moins 32 caractères pour signer les JWT locaux.
# Exemple de génération : openssl rand -hex 32
LOCAL_JWT_SECRET=remplacez-par-une-cle-jwt-locale-aleatoire-de-64-caracteres

# Adresse IPv4 LAN de l’ordinateur qui exécute Docker, visible depuis le téléphone.
# Sous Windows : ipconfig ; sous macOS/Linux : ipconfig getifaddr en0 ou hostname -I.
PICON_LOCAL_HOST_IP=192.168.1.25
PICON_LOCAL_BACKEND_PORT=8080
PICON_LOCAL_BIND_ADDRESS=0.0.0.0
PICON_LOCAL_PUBLIC_URL=http://${PICON_LOCAL_HOST_IP}:${PICON_LOCAL_BACKEND_PORT}
